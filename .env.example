# ==============================================================================
# Configuration DeepTutor Desktop - Variables d'environnement
# ==============================================================================
# Copiez ce fichier sous le nom '.env' pour personnaliser votre configuration.
# Les paramètres saisis ici seront transmis au conteneur officiel DeepTutor.
# Note : Vous pouvez également configurer directement vos clés et modèles
# depuis l'interface graphique de DeepTutor (Paramètres -> Modèles).

# --- Ports de l'application ---
DEEPTUTOR_PORT=3782
DEEPTUTOR_BACKEND_PORT=8001

# --- Fournisseurs de modèles LLM principaux ---
# OpenAI (GPT-4o, GPT-4o-mini, o1, o3-mini...)
OPENAI_API_KEY=
OPENAI_API_BASE=https://api.openai.com/v1

# DeepSeek (DeepSeek-V3, DeepSeek-R1...)
DEEPSEEK_API_KEY=
DEEPSEEK_API_BASE=https://api.deepseek.com/v1

# Anthropic (Claude 3.5 Sonnet, Claude 3.7 Sonnet...)
ANTHROPIC_API_KEY=

# Google Gemini (Gemini 2.5 Flash, Gemini 2.5 Pro...)
GEMINI_API_KEY=

# Groq (Llama-3, Mixtral...)
GROQ_API_KEY=

# Mistral AI
MISTRAL_API_KEY=

# OpenRouter / SiliconFlow / Novita AI
OPENROUTER_API_KEY=
SILICONFLOW_API_KEY=

# --- Modèles Locaux (Ollama / LM Studio / vLLM) ---
# Astuce : Depuis Docker, utilisez 'host.docker.internal' plutôt que 'localhost'
OLLAMA_BASE_URL=http://host.docker.internal:11434
LMSTUDIO_BASE_URL=http://host.docker.internal:1234/v1

# --- Moteurs de recherche Web & RAG ---
# Tavily Search (Recommandé pour la recherche documentaire approfondie)
TAVILY_API_KEY=

# Serper / Bing / Serply
SERPER_API_KEY=

# --- Paramètres avancés ---
# Définir à true pour activer les logs détaillés dans la console DeepTutor
DEBUG=false
