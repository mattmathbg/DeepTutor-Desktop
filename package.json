{
  "name": "deeptutor-desktop",
  "version": "1.0.0",
  "description": "Native desktop wrapper orchestrating HKUDS/DeepTutor via Docker",
  "main": "src/main/index.js",
  "author": "DeepTutor Desktop Team",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/mattmathbg/DeepTutor-Desktop.git"
  },
  "homepage": "https://github.com/mattmathbg/DeepTutor-Desktop#readme",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --enable-logging",
    "package:win": "electron-builder --win",
    "package:linux": "electron-builder --linux AppImage deb",
    "release": "electron-builder --publish always"
  },
  "dependencies": {
    "dotenv": "^16.4.7"
  },
  "devDependencies": {
    "electron": "^34.2.0",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "info.deeptutor.desktop",
    "productName": "DeepTutor",
    "directories": {
      "output": "release"
    },
    "publish": {
      "provider": "github",
      "owner": "mattmathbg",
      "repo": "DeepTutor-Desktop"
    },
    "files": [
      "src/**/*"
    ],
    "extraResources": [
      "docker-compose.yml",
      ".env.example"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "src/renderer/assets/icon.ico"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Education",
      "icon": "src/renderer/assets/icon.png"
    }
  }
}
